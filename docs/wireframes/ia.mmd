  ROOT --> ORDER("주문 / 결제")
  ROOT --> CART("장바구니")
  ROOT --> BOARD("동네생활")
  ROOT --> MY("마이페이지")

  HOME --> H1("시작 페이지<br/>/")

  AUTH --> A1("로그인<br/>/user/login")
  AUTH --> A2("회원가입<br/>/user/join")
  AUTH --> A3("카카오 OAuth<br/>/auth/kakao")
  AUTH --> A4("네이버 OAuth<br/>/auth/naver")
  AUTH --> A5("로그아웃<br/>/user/logout")

  PROD --> P1("둘러보기 · 검색 · 내 주변<br/>/product/")
  PROD --> P2("상품 상세<br/>/product/detail?id=")
