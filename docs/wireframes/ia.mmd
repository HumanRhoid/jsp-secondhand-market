  ORDER --> O3("결제 실패<br/>/order/fail")

  CART --> C1("장바구니 목록<br/>/cart/")
  CART --> C2("담기<br/>/cart/add")
  CART --> C3("빼기<br/>/cart/remove")

  BOARD --> B1("글 목록<br/>/board/")
  BOARD --> B2("글 보기<br/>/board/view?id=")
  BOARD --> B3("글쓰기<br/>/board/write")

  MY --> M1("🔒 내 프로필<br/>/user/profile")
  MY --> M2("🔒 프로필 수정<br/>/user/edit → update")
  MY --> M3("회원 탈퇴<br/>/user/delete")
  MY --> M4("에러 페이지<br/>404 · 500")

  classDef root fill:#000000,stroke:#000000,color:#ffffff,font-weight:bold
