# 이 파일을 db.properties로 복사한 뒤 실제 접속 정보를 입력하세요.
# db.properties는 .gitignore에 등록되어 커밋되지 않습니다.
db.url=jdbc:postgresql://localhost:5432/SecondheadServiceDB
db.user=postgres
db.password=YOUR_PASSWORD

redis.host=localhost
redis.port=6379

# 업로드된 매물 사진을 저장할 외부 폴더 (앱 바깥 → 재배포해도 사진 유지). 슬래시(/) 사용
upload.dir=C:/Users/계정명/upload

# ── 외부 API 연동 (키 발급 후 채우면 해당 기능 활성화) ──
# 카카오 개발자(https://developers.kakao.com) — 맵/로그인
kakao.js.key=YOUR_KAKAO_JAVASCRIPT_KEY
kakao.rest.key=YOUR_KAKAO_REST_API_KEY
# 네이버 개발자(https://developers.naver.com) — 네이버 로그인
naver.client.id=YOUR_NAVER_CLIENT_ID
naver.client.secret=YOUR_NAVER_CLIENT_SECRET
# 토스페이먼츠(https://docs.tosspayments.com) — 결제. 아래는 문서 공개 테스트 키(가입 불필요, 실결제 안 됨)
toss.client.key=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
toss.secret.key=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
# OAuth 콜백 베이스 URL
oauth.base.url=http://localhost:8080/secondhand
